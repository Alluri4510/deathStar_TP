import 'package:flutter/material.dart';
import 'package:flutter_secure_storage/flutter_secure_storage.dart';
import 'package:local_auth/local_auth.dart';

void main() {
  runApp(const DeathStar());
}

class DeathStar extends StatelessWidget {
    const DeathStar({super.key});
  @override
  Widget build(BuildContext context) {
    return MaterialApp(

      home: PasswordScreen(),
    );
  }
}

class PasswordScreen extends StatefulWidget {
  @override
  _PasswordScreenState createState() => _PasswordScreenState();
}

class _PasswordScreenState extends State<PasswordScreen> {
  final FlutterSecureStorage _storage = FlutterSecureStorage();
  final TextEditingController _passwordController = TextEditingController();
  String? savePassword;
  bool isSettingPassword = false;

  @override
  void initState() {
    super.initState();
    _checkPassword();
  }

  Future<void> _checkPassword() async {
    String? password= await _storage.read(key: 'app_password');
    setState((){
      savePassword = password;
      isSettingPassword = password = null;
    });
  }

  Future<void> _savePassword(string password) async {
    await password = await _storage.read(key: 'app_password');
    setState(() {
      savedPassword = password;
      isSettingPassword = password = null;
    });
  }

  void _validatePassword(){
    if (_passwordController.text == savedPassword) {
      Navigator.pushReplacement(
        context,
        MaterialPageRoute(builder: (context) => ImageTableScreen()),
      );
    } else {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(context: Text('Incorrect password!')),
      );
    }
  }
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Center(
        child: Padding(
          padding: const EdgeInsets.all(20.0),
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Text(isSettingPassword ? 'Set a Password' : 'Enter Password',
                style: const TextStyle(fontSize: 22, fontWeight: FontWeight.bold),
                ),
                SizedBox(height: 20),
                TextField(
                controller: _passwordController,
                obscureText: true,
                decoration: InputDecoration(
                  border: OutlineInputBorder(),
                  hintText: isSettingPassword ? 'Set your password' : 'Enter password',
                ),
              ),
              const SizedBox(height: 20),
              ElevatedButton(
                onPressed: () {
                  if (isSettingPassword) {
                    _savePassword(_passwordController.text);
                  } else {
                    _validatePassword
                  }
                },
                child: Text(isSettingPassword ? 'Save Password' : 'Unlock'),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class ImageTableScreen extends StatelessWidget {
  final List<String> imageUrls = List.generate(
      10, (index) => 'http://10.17.204.124:8000/images/$index');

      final LocalAuthentication auth = LocalAuthentication();

  void openImageInNewTab(String url) {
    // This works only in web environments
    var encodedUrl = Uri.encodeFull(url);
    var script = "window.open('$encodedUrl', '_blank');";
    print(script); // Prints the script for debugging in online environments
  }
  
  Future<void> _authenticateWithBiometrics(BuildContext context) async {
    try {
      bool authenticated = await auth.authenticate(
        localizedReason: 'Please authenticate to access the app',
        options: const AuthenticationOptions(biometriceOnly: true),
      );
      if (authenticated) {
        Navigator.pushReplacement(
          context,
          MaterialPageRoute(builder: (context) => ImageTableScreen()),
        );
      }
    } catch (e) {
      print("Error during authentication $e");
    }
  }
  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('Images')),
      body: SingleChildScrollView(
        child: Table(
          columnWidths: {0: FlexColumnWidth()},
          children: imageUrls.map((url) {
            return TableRow(children: [
              GestureDetector(
                onTap: () => openImageInNewTab(url),
                child: Padding(
                  padding: const EdgeInsets.all(8.0),
                  child: Image.network(url, height: 100, errorBuilder:
                      (context, error, stackTrace) {
                    return Icon(Icons.broken_image, size: 100);
                  }),
                ),
              ),
            ]);
          }).toList(),
        ),
      ),
    );
  }
}
